generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  STAFF
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  DRIVERS_LICENSE
  SSN
  TAX_ID
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum TransactionType {
  TRANSFER_INTERNAL
  TRANSFER_P2P
  TRANSFER_EXTERNAL
  DEPOSIT
  WITHDRAWAL
  BILL_PAYMENT
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

enum CardNetwork {
  VISA
  MASTERCARD
}

enum NotificationType {
  TRANSACTION
  SECURITY
  SYSTEM
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  address         String
  role            Role       @default(USER)
  kycStatus       KycStatus  @default(PENDING)
  kycLevel        Int        @default(1)
  emailVerified   Boolean    @default(false)
  sessionVersion  Int        @default(0)
  twoFAEnabled    Boolean    @default(false)
  twoFASecret     String?
  transactionPinHash String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  accounts        Account[]
  payees          Payee[]
  loginActivity   LoginActivity[]
  notifications   Notification[]
  kycDocuments    KycDocument[]
  auditLogs       AuditLog[]

  @@index([email])
}

model Account {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AccountType
  nickname       String?
  accountNumber  String       @unique
  routingNumber  String
  balance        Decimal      @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  card                  Card?
  outgoingTransactions  Transaction[] @relation("SourceAccount")
  incomingTransactions  Transaction[] @relation("DestinationAccount")
  payees                Payee[]

  @@index([userId])
}

model Transaction {
  id                  String            @id @default(cuid())
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  amount              Decimal          
  category            String?
  description         String?
  counterpartyName    String?
  // Client-supplied key that makes retries / double-submits safe (unique per transaction).
  idempotencyKey      String?           @unique

  sourceAccountId      String?
  sourceAccount        Account?  @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccountId String?
  destinationAccount   Account?  @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  createdAt           DateTime          @default(now())
  completedAt         DateTime?

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
}

model Card {
  id           String      @id @default(cuid())
  accountId    String      @unique
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  last4        String
  network      CardNetwork @default(VISA)
  expiryMonth  Int
  expiryYear   Int
  frozen       Boolean     @default(false)
  spendLimit   Decimal     @default(5000)
  createdAt    DateTime    @default(now())
}

model Payee {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  accountRef      String
  sourceAccountId String
  sourceAccount   Account           @relation(fields: [sourceAccountId], references: [id])
  amount          Decimal          
  frequency       ScheduleFrequency @default(ONCE)
  isActive        Boolean           @default(true)
  nextRunAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([userId])
  @@index([sourceAccountId])
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType  @default(SYSTEM)
  title     String
  body      String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId])
}

model KycDocument {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          Int
  type           KycDocumentType
  status         KycDocumentStatus @default(PENDING)
  fileName       String?
  mimeType       String?
  fileData       Bytes?
  textValue      String?
  rejectionReason String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, level, status])
  @@index([createdAt])
  @@index([reviewedById])
}

model VerificationToken {
  id        String               @id @default(cuid())
  email     String
  token     String               @unique
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  expires   DateTime
  createdAt DateTime              @default(now())

  @@index([email, type])
  @@index([expires])
}

// Immutable record of privileged staff balance adjustments.
model AuditLog {
  id              String   @id @default(cuid())
  actorId         String
  actor           User     @relation(fields: [actorId], references: [id])
  action          String
  targetAccountId String?
  transactionId   String?
  amount          Decimal?
  reason          String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
